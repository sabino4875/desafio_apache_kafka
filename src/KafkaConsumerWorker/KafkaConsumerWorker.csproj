<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<PackageId>Kafka.Consumer.Console</PackageId>
		<RootNamespace>Kafka.Consumer.Console</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Deterministic>false</Deterministic>
		<NoWarn>$(NoWarn);CA1031;CA1812;CA1852;</NoWarn>
