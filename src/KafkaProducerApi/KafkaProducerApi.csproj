<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<PackageId>Kafka.Producer.Api</PackageId>
		<RootNamespace>Kafka.Producer.Api</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Deterministic>false</Deterministic>
		<NoWarn>$(NoWarn);CA1031;CA1812;CA1852;</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <Content Remove="config.json" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="config.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Confluent.Kafka" Version="2.16.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Kafka.ServiceDefaults\Kafka.ServiceDefaults.csproj" />
	  <ProjectReference Include="..\Kafka.Common\Kafka.Common.csproj" />
	</ItemGroup>

</Project>
